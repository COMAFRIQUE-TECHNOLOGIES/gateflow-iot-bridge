# Configuration Bridge MQTT -> Laravel
# Copier ce fichier en .env sur le serveur.

# --- Source MQTT ---
# Valeurs possibles :
# - chirpstack: payload ChirpStack v4 JSON transmis vers /api/iot/webhook?event=up
# - ttn: payload TTN enveloppé dans raw_message pour compatibilité historique
MQTT_PAYLOAD_FORMAT=chirpstack

# --- ChirpStack local ---
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=chirpstack
MQTT_PASSWORD=votre_mot_de_passe_mqtt_chirpstack
MQTT_TOPIC_SUBSCRIBE=application/+/device/+/event/+

# --- The Things Network historique ---
# MQTT_PAYLOAD_FORMAT=ttn
# MQTT_BROKER_HOST=eu1.cloud.thethings.network
# MQTT_BROKER_PORT=1883
# MQTT_USERNAME=gateflow@ttn
# MQTT_PASSWORD=votre_cle_api_ttn
# MQTT_TOPIC_SUBSCRIBE=v3/+/devices/+/up

# --- Laravel API Target ---
LARAVEL_HOST=gateflow.on-forge.com
LARAVEL_PORT=443
LARAVEL_PROTOCOL=https
LARAVEL_ENDPOINT=/api/iot/webhook
LARAVEL_REJECT_UNAUTHORIZED=true

# --- Security ---
# Doit correspondre à IOT_WEBHOOK_SECRET dans .env Laravel
IOT_WEBHOOK_SECRET=votre_secret_tres_long_et_aleatoire

# --- Environment ---
NODE_ENV=production

# Identité stable et journal indépendant pour chaque destination.
MQTT_CLIENT_ID=sodeci-bridge
MQTT_GATEWAY_TOPICS=eu868/gateway/+/event/stats,gateway/+/event/stats
BRIDGE_SPOOL_DIR=/home/forge/sodeci-iot-spool
BRIDGE_MAX_BYTES=268435456
BRIDGE_HTTP_TIMEOUT_MS=10000
BRIDGE_CONCURRENCY=4
BRIDGE_REQUIRE_DURABLE_ACK=true
